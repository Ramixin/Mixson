{
  "schemaVersion": 1,
  "id": "mixson",
  "version": "${version}",
  "name": "Mixson",
  "description": "Allows in-code manipulation of asset/data resources",
  "authors": [
    "Ramixin"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/mixson/icon.png",
  "environment": "*",
  "mixins": [
    "mixson.mixins.json"
  ],
  "entrypoints": {
    "main": [
      "net.ramixin.mixson.inline.Mixson"
    ],
    "client": [
      "net.ramixin.mixson.client.MixsonClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": ">=${minecraft_version}"
  }
}
